{
    "expo": {
        "name": "Rancho",
        "slug": "rancho_mobile",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/text_icon.png",
        "scheme": "myapp",
        "userInterfaceStyle": "automatic",
        "splash": {
            "image": "./assets/images/text_splash.png",
            "resizeMode": "cover",
            "backgroundColor": "#f9f9f9"
        },
        "assetBundlePatterns": ["**/*"],
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/text_icon.png",
                "backgroundColor": "#f9f9f9"
            },
            "package": "com.snipermiope.rancho_mobile"
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": ["expo-router", "expo-font", "expo-web-browser"],
        "experiments": {
            "typedRoutes": true
        },
        "extra": {
            "router": {
                "origin": false
            },
            "eas": {
                "projectId": "13bca209-edd4-4c37-b7e6-40a347709478"
            }
        }
    }
}
